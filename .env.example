# ==============================================================================
# SmartRecruit - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Fill in secure values for all required credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Configuration
# ------------------------------------------------------------------------------
# Root username for MongoDB container initialization
MONGO_ROOT_USERNAME=smartrecruit_admin

# Root password for MongoDB container initialization
MONGO_ROOT_PASSWORD=

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
# Password used to secure Redis server and authentication
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Vector Database (Qdrant) Configuration
# ------------------------------------------------------------------------------
# API key used to authenticate client requests to Qdrant
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# Graph Database (Neo4j) Configuration
# ------------------------------------------------------------------------------
# Password for Neo4j database user (username defaults to 'neo4j')
NEO4J_PASSWORD=

# ------------------------------------------------------------------------------
# JWT & Security Configuration
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign JWT access tokens (minimum 32 characters)
SECRET_KEY=

# ------------------------------------------------------------------------------
# SMTP / Transactional Email Delivery Configuration
# ------------------------------------------------------------------------------
# SMTP server hostname (use 'mailpit' for local dev, or 'smtp.gmail.com' for production)
SMTP_HOST=mailpit

# SMTP server port (1025 for Mailpit, 587 for standard STARTTLS)
SMTP_PORT=1025

# SMTP authentication username / sender email address
SMTP_USER=

# SMTP authentication password or App Password (e.g., Google App Password)
SMTP_PASSWORD=

# Enable STARTTLS encryption (true for port 587, false for Mailpit)
SMTP_STARTTLS=false

# Enable SSL/TLS encryption (true for port 465, false for 587/1025)
SMTP_USE_TLS=false

# Outgoing email sender address
EMAILS_FROM_EMAIL=no-reply@smartrecruit.local

# Outgoing email sender display name
EMAILS_FROM_NAME=SmartRecruit
